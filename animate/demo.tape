Output demo.mp4

Set Width 1080
Set Height 1080
Set FontSize 26
Set Padding 40
# Set Theme "Tomorrow Night Bright"
Set Theme {"name": "CustomDark", "black": "#181818", "red": "#f44747", "green": "#23d18b", "yellow": "#f5f543", "blue": "#3b8eea", "purple": "#d670d6", "cyan": "#29b8db", "white": "#d8d8d8", "brightBlack": "#666666", "brightRed": "#f14c4c", "brightGreen": "#23d18b", "brightYellow": "#f5f543", "brightBlue": "#3b8eea", "brightPurple": "#d670d6", "brightCyan": "#29b8db", "brightWhite": "#e5e5e5", "background": "#181818", "foreground": "#d8d8d8", "cursor": "#d8d8d8", "selection": "#264f78"}
Set Framerate 60

Type "uv run python animate.py"
Enter
Sleep 30s